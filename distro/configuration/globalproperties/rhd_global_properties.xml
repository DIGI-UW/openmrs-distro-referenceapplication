<config>
    <globalProperties>
        <globalProperty>
            <property>log.level</property>
            <!-- Core applies this when the property is saved. The packaged log4j2.xml has no logger
                 for org.openmrs.module.rhdflags, so core applies that entry to org.openmrs, and all
                 of it logs at info; see "Logging" in the rhdflags README for a logger of its own. -->
            <value>org.openmrs.api:info,org.openmrs.module.rhdflags:info</value>
            <description>Log levels, as a comma separated list of package:level pairs.</description>
        </globalProperty>
    </globalProperties>
</config>
