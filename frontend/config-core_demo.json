  "@openmrs/esm-patient-registration-app": {
    "defaultPatientIdentifierTypes": [
      "fdd6f720-743b-57fc-915a-87c0f571097b",
      "060a2595-da89-5509-8cf4-645a8e50ad8a"
    ],
    "sections": [
      "demographics",
      "contact",
      "relationships",
      "rhd-registration"
    ],
    "sectionDefinitions": [
      {
        "id": "rhd-registration",
        "name": "RHD Registration",
        "fields": [
          "consentStatement",
          "consentGiven",
          "consentRelationship",
          "consentPerson",
          "consentDate",
          "assignedCardiacClinic",
          "primaryCareClinic",
          "textItSettings",
          "primaryPhone",
          "phoneOwnerName",
          "phoneOwnerRelationship",
          "whatsappAvailable",
          "telegramAvailable"
        ]
      }
    ],
    "fieldDefinitions": [
      {
        "id": "consentStatement",
        "type": "text",
        "label": "I told the patient the following about the use of their health information: Their personal health information will go into a computer program that helps manage their heart care. The information will be kept on special computers in the United States that store their data. The data may be used for other purposes, such as researching ways to improve treatment for people with heart conditions around the world. No information that directly identifies them, such as their name or account numbers, will be shared with anyone else. Their treatment does not depend on giving this permission and they can change their mind anytime so that new health information will not be used or shared. The patient told me that they understood the risks related to this information, and the patient freely agreed to share their data."
      },
      {
        "id": "assignedCardiacClinic",
        "type": "person attribute",
        "uuid": "fe261119-2911-5b36-be40-8f9827826987",
        "label": "Assigned Cardiac Clinic",
        "validation": {
          "required": true
        }
      },
      {
        "id": "primaryCareClinic",
        "type": "person attribute",
        "uuid": "695f2990-236f-5d7c-b8aa-ddbdb22400f4",
        "label": "Primary Care Clinic",
        "validation": {
          "required": true
        }
      },
      {
        "id": "consentGiven",
        "type": "person attribute",
        "uuid": "e15bf9b7-249e-5d75-907d-937b8d9b0c46",
        "label": "Consent Obtained",
        "customConceptAnswers": [
          {
            "uuid": "1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "Yes"
          },
          {
            "uuid": "1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "No"
          }
        ],
        "validation": {
          "required": true
        }
      },
      {
        "id": "consentRelationship",
        "type": "person attribute",
        "uuid": "23f7173b-bec5-5fac-81db-cbbb1046e05e",
        "label": "Relationship to Patient (optional)",
        "customConceptAnswers": [
          {
            "uuid": "edebe52c-de16-5ba7-ad1c-9f0d6a2bb323",
            "label": "Self"
          },
          {
            "uuid": "3667d093-11ca-5dc5-8734-ec2dec08fcec",
            "label": "Guardian"
          }
        ]
      },
      {
        "id": "consentPerson",
        "type": "person attribute",
        "uuid": "a8ff9d47-dcdc-579a-a9b3-1d883c4d344b",
        "label": "Name of person giving consent (if Guardian)"
      },
      {
        "id": "consentDate",
        "type": "person attribute",
        "uuid": "b29617e3-c49e-5893-8dc7-e06b125a0264",
        "label": "Date of Consent (required if consent is Yes)",
        "allowFutureDates": false
      },
      {
        "id": "textItSettings",
        "type": "person attribute",
        "uuid": "68b50c5e-250e-5dab-bd34-fb007756a7ed",
        "label": "Text-It Settings (optional)",
        "customConceptAnswers": [
          {
            "uuid": "1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "Yes"
          },
          {
            "uuid": "1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "No"
          }
        ]
      },
      {
        "id": "primaryPhone",
        "type": "person attribute",
        "uuid": "542c6fd2-05ca-53e3-a4f5-cd23bc1abd8f",
        "label": "Primary Phone"
      },
      {
        "id": "phoneOwnerName",
        "type": "person attribute",
        "uuid": "ea3cb7ae-ffbe-5aee-8343-44977898f675",
        "label": "Phone Owner Name"
      },
      {
        "id": "phoneOwnerRelationship",
        "type": "person attribute",
        "uuid": "b36b2e80-c1ad-5417-84fc-89075904a089",
        "label": "Phone Owner Relationship"
      },
      {
        "id": "whatsappAvailable",
        "type": "person attribute",
        "uuid": "9b054d06-b812-5d57-b057-2e1b0338a888",
        "label": "WhatsApp Available (optional)",
        "customConceptAnswers": [
          {
            "uuid": "1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "Yes"
          },
          {
            "uuid": "1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "No"
          }
        ]
      },
      {
        "id": "telegramAvailable",
        "type": "person attribute",
        "uuid": "d6764a78-a775-501e-b2ce-8b8bd431fd74",
        "label": "Telegram Available (optional)",
        "customConceptAnswers": [
          {
            "uuid": "1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "Yes"
          },
          {
            "uuid": "1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "label": "No"
          }
        ]
      }
    ]
